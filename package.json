{
  "name": "engineering-blogs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "description": "Aggregator for engineering blogs: scheduled RSS ingest, static site with instant search",
  "license": "MIT",
  "author": "Sunny Sharma",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamsunny/devreads.fyi.git"
  },
  "scripts": {
    "import:opml": "node scripts/import-opml.mjs",
    "ingest": "node ingest/run.mjs",
    "build": "astro build && node scripts/build-search-index.mjs && node scripts/build-auth-client.mjs",
    "check:analytics": "node scripts/verify-analytics.mjs",
    "check:sharing": "node scripts/verify-sharing-tags.mjs",
    "check:seo": "node scripts/verify-structured-data.mjs",
    "test:seo:browser": "node tests/structured-data.browser.mjs",
    "typecheck:worker": "tsc --project tsconfig.worker.json",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/check-build",
    "test:accounts": "node --test tests/favorites-store.test.mjs tests/auth-config.test.mjs && npm run check:worker && node --test tests/accounts.runtime.test.mjs",
    "test:accounts:browser": "node tests/accounts.browser.mjs",
    "dev:accounts": "node scripts/dev-accounts.mjs",
    "dev": "astro dev",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "firebase": "13.0.0",
    "jose": "6.2.12",
    "rss-parser": "^3.13.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "playwright-core": "1.64.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "undici": "7.30.0",
    "esbuild": "0.28.1",
    "sharp": "0.35.5"
  }
}
