// Astro remains static; the Worker records page views and serves counter reads.
// The name must match the existing Worker exactly - changing it would deploy a
// brand-new Worker instead of updating devreads.fyi.
{
  "name": "devreads-fyi",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "devreads.fyi", "custom_domain": true },
    { "pattern": "www.devreads.fyi", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "COUNTER_MODE": "production", "AUTH_MODE": "production",
    "AUTH_BASE_URL": "https://devreads.fyi", "AUTH_ENABLED": "false",
    "FIREBASE_PROJECT_ID": "", "FIREBASE_API_KEY": "", "FIREBASE_AUTH_DOMAIN": "", "FIREBASE_APP_ID": ""
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{
    "binding": "AUTH_DB", "database_name": "devreads-auth-production",
    "database_id": "aeb7e24d-875d-440c-a75f-8d8ad141c6f2", "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "FAVORITES_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{
      "name": "VISIT_COUNTER",
      "class_name": "VisitCounter",
      "script_name": "devreads-visit-counter"
    }]
  },
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } },
  "env": {
    "staging": {
      "name": "devreads-fyi-staging", "routes": [], "workers_dev": true, "preview_urls": false,
      "vars": { "COUNTER_MODE": "preview", "AUTH_MODE": "staging", "AUTH_BASE_URL": "https://devreads-fyi-staging.skrajobra-2008.workers.dev", "AUTH_ENABLED": "false", "FIREBASE_PROJECT_ID": "", "FIREBASE_API_KEY": "", "FIREBASE_AUTH_DOMAIN": "", "FIREBASE_APP_ID": "" },
      "d1_databases": [{ "binding": "AUTH_DB", "database_name": "devreads-auth-staging", "database_id": "c2f5e99c-658d-475a-9091-4b8b7237a03c", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
        { "name": "FAVORITES_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
      ],
      "durable_objects": { "bindings": [] }
    }
  }
}
