---
import { posts } from '../lib/data.mjs';
import { isUtilityPage, structuredData, serializeStructuredData } from '../lib/structured-data.mjs';
const { title = 'devreads.fyi - engineering reads', description = 'Discover the latest engineering articles from independent and company blogs. Browse by topic or source, search the archive, and save your favorites.', items, breadcrumbs = [] } = Astro.props;
const root = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://devreads.fyi').href;
const home = new URL(root, Astro.site ?? 'https://devreads.fyi').href;
const noindex = isUtilityPage(Astro.url.pathname, root);
const schema = noindex ? null : structuredData({ canonical, home, title, description, items, breadcrumbs });
const postCount = posts.length.toLocaleString('en-US');
const faviconSvg =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="#0e1411"/><text x="5" y="17" font-family="monospace" font-size="12" fill="#3fd68f">&gt;_</text></svg>';
const favicon = 'data:image/svg+xml,' + encodeURIComponent(faviconSvg);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // CookieHub updates these defaults with the visitor's consent choices.
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 700,
    });
  </script>
  <script is:inline src="https://cdn.cookiehub.eu/c2/fa59a1b5.js"></script>
  <script is:inline type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
      if (window.cookiehub) {
        var cpm = {};
        window.cookiehub.load(cpm);
      }
    });
  </script>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VR4M09Z7LQ"></script>
  <script is:inline>
    gtag('js', new Date());
    gtag('config', 'G-VR4M09Z7LQ');
  </script>
  <script is:inline>document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {schema && <script is:inline type="application/ld+json" set:html={serializeStructuredData(schema)} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="devreads.fyi" />
  <meta property="og:image" content={new URL('og.png', Astro.site ?? 'https://devreads.fyi').href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('og.png', Astro.site ?? 'https://devreads.fyi').href} />
  <link rel="icon" href={favicon} />
  <link rel="alternate" type="application/rss+xml" title="devreads.fyi" href={`${root}feed.xml`} />
  <style is:global>
    :root {
      color-scheme: light;
      --bg: #fdfdfc; --surface: #f3f4f2; --fg: #1b1d1b; --muted: #67706a; --faint: #949d96;
      --border: #e2e5e1; --accent: #0e8f63; --accent-bg: #e2f5eb; --danger: #b3362c; --ok: #2c7a4b;
      --mono: ui-monospace, 'Cascadia Code', Consolas, Menlo, monospace;
    }
    html[data-theme='dark'] {
      color-scheme: dark;
      --bg: #101412; --surface: #18211b; --fg: #dbe7df; --muted: #9db1a5; --faint: #6d8276;
      --border: #243029; --accent: #3fd68f; --accent-bg: #12281d; --danger: #e08379; --ok: #7bc99a;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body {
      margin: 0; background: var(--bg); color: var(--fg);
      font: 15px/1.55 system-ui, 'Segoe UI', Roboto, sans-serif;
    }
    a { color: inherit; text-decoration: none; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
    header.top {
      position: sticky; top: 0; z-index: 20; background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .top-inner { display: flex; align-items: center; gap: 14px; padding: 10px 16px; }
    .brand { font-family: var(--mono); font-weight: 600; font-size: 15.5px; white-space: nowrap; }
    .brand .prompt, .brand .cursor { color: var(--accent); }
    @media (prefers-reduced-motion: no-preference) {
      .brand .cursor { animation: blink 1.2s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }
    }
    .tagline { font-family: var(--mono); font-size: 12px; color: var(--faint); white-space: nowrap; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
    @media (max-width: 760px) { .tagline { display: none; } }
    .searchbox {
      flex: 1; display: flex; align-items: center; gap: 8px; cursor: text;
      border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px;
      color: var(--faint); background: var(--surface); font-size: 12.5px; min-width: 120px;
      font-family: var(--mono);
    }
    .searchbox kbd { margin-left: auto; }
    .searchbox span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    @media (max-width: 560px) {
      .top-inner { flex-wrap: wrap; gap: 10px; }
      nav.links { order: 9; flex-basis: 100%; justify-content: space-between; gap: 10px; font-size: 13px; }
      .searchbox { min-width: 0; }
      .title-line { flex-wrap: wrap; gap: 4px 10px; }
    }
    kbd {
      border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 4px;
      padding: 0 5px; font-size: 11px; font-family: var(--mono); color: var(--muted);
    }
    nav.links { display: flex; gap: 14px; font-size: 13.5px; color: var(--muted); }
    nav.links a:hover { color: var(--fg); }
    #theme-toggle {
      background: none; border: 0; padding: 4px; cursor: pointer; color: var(--muted);
      display: flex; align-items: center;
    }
    #theme-toggle:hover { color: var(--fg); }
    #theme-toggle .ic-sun { display: none; }
    html[data-theme='dark'] #theme-toggle .ic-sun { display: block; }
    html[data-theme='dark'] #theme-toggle .ic-moon { display: none; }
    #new-pill {
      display: none; align-items: center; gap: 8px; margin: 10px 0 0; padding: 6px 12px;
      background: var(--accent-bg); color: var(--accent); border-radius: 999px; font-size: 12.5px; width: fit-content;
    }
    #new-pill button { background: none; border: 0; color: inherit; font: inherit; cursor: pointer; text-decoration: underline; padding: 0; }
    main.wrap { padding-top: 12px; padding-bottom: 48px; }
    h2.day { font-size: 12px; font-weight: 600; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; margin: 22px 0 4px; font-family: var(--mono); }
    .row { display: flex; gap: 14px; padding: 16px 12px; border-radius: 10px; position: relative; }
    .row + .row { border-top: 1px solid var(--border); }
    .row:hover, .row.sel { background: var(--surface); }
    .row.sel { outline: 1px solid var(--border); }
    .avatar {
      width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-weight: 600; background: hsl(var(--h) 60% 90%); color: hsl(var(--h) 60% 28%);
      position: relative; overflow: hidden;
    }
    .avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    html[data-theme='dark'] .avatar { background: hsl(var(--h) 35% 26%); color: hsl(var(--h) 60% 80%); }
    .row-main { flex: 1; min-width: 0; }
    .meta { margin: 0; font-size: 12.5px; color: var(--muted); display: flex; gap: 6px; flex-wrap: wrap; }
    .meta > * + *::before { content: '·'; margin-right: 6px; color: var(--faint); }
    .meta .src { font-weight: 600; }
    .title-line { display: flex; align-items: flex-start; gap: 10px; }
    .title-line .title { flex: 1; min-width: 0; }
    .src-pill {
      flex-shrink: 0; margin-top: 3px; font-size: 11px; font-weight: 600; white-space: nowrap;
      background: var(--accent-bg); color: var(--accent); border-radius: 999px; padding: 2px 10px;
      max-width: 180px; overflow: hidden; text-overflow: ellipsis;
    }
    .src-pill:hover { text-decoration: underline; }
    .title { margin: 2px 0 0; font-size: 15.5px; font-weight: 600; line-height: 1.4; }
    .title a:hover { text-decoration: underline; }
    @media (max-width: 560px) {
      .title-line .title { flex-basis: 100%; }
    }
    .row.unread .title::before {
      content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%;
      background: var(--accent); margin-right: 7px; vertical-align: 2px;
    }
    .summary {
      margin: 3px 0 6px; font-size: 13.5px; color: var(--muted);
      max-width: 100ch; line-height: 1.6;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .tags { margin: 0; display: flex; gap: 6px; flex-wrap: wrap; }
    .chip {
      font-size: 11.5px; border: 1px solid var(--border); border-radius: 999px; padding: 1.5px 9px; color: var(--muted);
      background: var(--bg);
    }
    a.chip:hover { border-color: var(--faint); color: var(--fg); }
    .post-actions { display: flex; flex-shrink: 0; align-self: flex-start; margin: -6px -6px 0 0; }
    .favorite-btn, .share-btn {
      background: none; border: 0; color: var(--muted); cursor: pointer; padding: 0;
      width: 32px; height: 32px; display: grid; place-items: center; border-radius: 7px;
    }
    .favorite-btn:hover, .share-btn:hover, .share-btn[aria-expanded='true'] { color: var(--accent); background: var(--accent-bg); }
    .post-actions button:focus-visible, .share-menu :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    @media (max-width: 560px), (pointer: coarse) {
      .post-actions { flex-direction: column; }
      .favorite-btn, .share-btn { width: 44px; height: 44px; }
    }
    .favorite-btn.favorited { color: var(--accent); }
    .favorite-btn.favorited .fill { fill: currentColor; }
    .favorite-btn:disabled { cursor: wait; opacity: .6; }
    .account-link { font: 12px var(--mono); color: var(--accent); white-space: nowrap; }
    .account-feedback { font-size: 12.5px; }
    .account-feedback p { margin: 12px 0 0; color: var(--muted); }
    .account-feedback p[data-error='true'] { color: var(--danger); }
    .favorite-nudge { display: flex; align-items: center; gap: 12px; margin: 14px 0 0; padding: 10px 12px; background: var(--accent-bg); border: 1px solid var(--border); border-radius: 8px; font-size: 12.5px; }
    .favorite-nudge p { margin: 0; flex: 1; }
    .favorite-nudge a, .account-panel a, .account-callout a { color: var(--accent); text-decoration: underline; }
    .favorite-nudge button { background: none; border: 0; color: var(--muted); cursor: pointer; min-width: 32px; min-height: 32px; }
    .account-panel { max-width: 480px; margin: 32px auto 48px; }
    .account-panel > p { color: var(--muted); font-size: 14px; line-height: 1.7; }
    .provider-buttons { display: grid; gap: 10px; margin: 24px 0; }
    .account-button { min-height: 44px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--fg); font: 12.5px var(--mono); cursor: pointer; }
    .account-button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
    .account-button:focus-visible, .account-link:focus-visible, .favorite-nudge button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .account-button:disabled { opacity: .6; cursor: default; }
    .provider-button { display: flex; justify-content: center; align-items: center; gap: 12px; background: var(--bg); }
    .provider-mark { font-family: sans-serif; font-size: 18px; font-weight: 700; }
    .account-callout { margin: 20px 0; padding: 12px 14px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); font-size: 13px; color: var(--muted); }
    .account-callout p { margin: 0 0 8px; }
    .account-callout p:last-child { margin-bottom: 0; }
    .account-fine { font-size: 12.5px !important; color: var(--muted); line-height: 1.7; }
    .account-name { font-size: 20px; margin-bottom: 4px; }
    .account-section-label { font: 12px var(--mono); color: var(--muted); margin-top: 28px; }
    .account-danger-zone { margin-top: 32px; padding-top: 4px; border-top: 1px solid var(--border); }
    .danger-button { color: var(--danger); }
    .share-menu {
      position: fixed; z-index: 40; width: 220px; max-width: calc(100vw - 16px); padding: 6px;
      max-height: calc(100dvh - 16px); overflow-y: auto; border: 1px solid var(--border); border-radius: 10px;
      background: var(--surface); box-shadow: 0 10px 30px rgb(0 0 0 / .2); font: 12.5px/1.5 var(--mono);
    }
    .share-menu[hidden], .share-menu [hidden] { display: none; }
    .share-menu [role='menuitem'] {
      display: flex; align-items: center; width: 100%; min-height: 40px; padding: 8px 10px;
      background: none; color: var(--fg); border: 0; border-radius: 6px; font: inherit; text-align: left; cursor: pointer;
    }
    .share-menu [role='menuitem']:hover, .share-menu [role='menuitem']:focus, .share-menu .copied {
      background: var(--accent-bg); color: var(--accent);
    }
    .share-menu p { margin: 4px 10px; color: var(--muted); font-size: 11px; }
    .share-menu input { width: 100%; padding: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--fg); font: inherit; }
    .pager { display: flex; align-items: center; gap: 16px; justify-content: center; margin: 26px 0; font-size: 13.5px; color: var(--muted); }
    .pager a { border: 1px solid var(--border); border-radius: 8px; padding: 6px 14px; }
    .pager a:hover { background: var(--surface); }
    footer.hints {
      border-top: 1px solid var(--border); color: var(--faint); font-size: 12px;
      padding: 12px 0 30px;
    }
    footer.hints .wrap { display: flex; gap: 16px; flex-wrap: wrap; }
    footer.hints .right { margin-left: auto; font-family: var(--mono); display: flex; gap: 12px; flex-wrap: wrap; }
    footer.hints .visit-count { white-space: nowrap; font-variant-numeric: tabular-nums; }
    table.sources { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 14px; }
    .sources-scroll { overflow-x: auto; }
    .sources-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    table.sources th { text-align: left; font-size: 12px; color: var(--faint); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--border); }
    table.sources td { padding: 7px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .badge { font-size: 11.5px; border-radius: 999px; padding: 1.5px 9px; font-weight: 600; font-family: var(--mono); }
    .badge.active { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
    .badge.backfilling { background: var(--accent-bg); color: var(--accent); }
    .badge.failing, .badge.quarantined { background: color-mix(in srgb, var(--danger) 12%, transparent); color: var(--danger); }
    .badge.new { background: var(--surface); color: var(--muted); }
    #search-overlay {
      position: fixed; inset: 0; z-index: 50; background: color-mix(in srgb, var(--fg) 28%, transparent);
      display: flex; justify-content: center; align-items: flex-start; padding: 8vh 16px 0;
    }
    #search-overlay[hidden] { display: none; }
    .search-panel {
      width: 100%; max-width: 640px; background: var(--bg); border: 1px solid var(--border);
      border-radius: 14px; overflow: hidden; box-shadow: 0 18px 50px rgb(0 0 0 / .25);
    }
    .search-head { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--border); }
    .search-head input { flex: 1; border: 0; outline: 0; background: none; color: var(--fg); font: inherit; font-size: 15px; }
    .search-filters { display: flex; gap: 8px; padding: 9px 14px; border-bottom: 1px solid var(--border); }
    .search-filters select {
      background: var(--surface); color: var(--muted); border: 1px solid var(--border); border-radius: 8px;
      font-size: 12.5px; padding: 4px 8px; max-width: 46%;
    }
    .search-results { max-height: 56vh; overflow-y: auto; padding: 4px 8px 8px; }
    .sr { display: block; padding: 9px 8px; border-radius: 8px; }
    .sr:hover, .sr.sel { background: var(--surface); }
    .sr .meta { font-size: 12px; }
    .sr .t { font-weight: 600; font-size: 14px; margin: 1px 0; }
    .sr .x { font-size: 12.5px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .sr mark { background: var(--accent-bg); color: var(--accent); border-radius: 3px; padding: 0 1px; }
    .search-empty { color: var(--faint); font-size: 13px; padding: 18px 12px; text-align: center; font-family: var(--mono); }
    .page-head h1 { font-size: 19px; margin: 18px 0 2px; }
    .page-head p { margin: 0; color: var(--muted); font-size: 13.5px; }
    .feed-head { margin-bottom: 16px; }
    .breadcrumbs { margin: 12px 0 2px; color: var(--muted); font: 11.5px/1.6 var(--mono); }
    .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 4px 8px; list-style: none; margin: 0; padding: 0; }
    .breadcrumbs li { display: flex; align-items: baseline; gap: 8px; min-width: 0; overflow-wrap: anywhere; }
    .breadcrumbs li + li::before { content: '/'; color: var(--faint); }
    .breadcrumbs a:hover { color: var(--accent); text-decoration: underline; }
    .breadcrumbs a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  </style>
</head>
<body data-base={root}>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href={root} aria-label="devreads.fyi home"><span class="prompt">~/</span>devreads<span class="cursor" aria-hidden="true">▍</span></a>
      <span class="tagline" aria-hidden="true">$ tail -f engineering</span>
      <button class="searchbox" id="search-open" aria-label="Search posts">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>grep {postCount} posts…</span>
        <kbd>/</kbd>
      </button>
      <nav class="links">
        <a href={root}>Latest</a>
        <a href={`${root}digest/`}>Digest</a>
        <a href={`${root}tags/`}>Tags</a>
        <a href={`${root}sources/`}>Sources</a>
        <a href={`${root}favorites/`}>Favorites</a>
      </nav>
      <a class="account-link" data-account-link href={`${root}signin/`} hidden>Sign in</a>
      <button id="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
        <svg class="ic-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="ic-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </header>
  <div class="wrap">
    <div id="new-pill"><span id="new-count"></span><button id="mark-read">Mark all read</button></div>
    <div class="account-feedback">
      <p id="account-status" role="status" aria-live="polite" hidden></p>
      <button class="account-button" type="button" data-account-retry hidden>Retry sync</button>
    </div>
    <div class="favorite-nudge" id="favorite-nudge" hidden>
      <p>Saved on this device. <a href={`${root}signin/`}>Sign in</a> to keep your favorites across devices.</p>
      <button type="button" data-dismiss-nudge aria-label="Dismiss sign-in suggestion">×</button>
    </div>
  </div>
  <main class="wrap">
    {breadcrumbs.length > 1 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>{breadcrumbs.map((crumb, index) => (
          <li>{index === breadcrumbs.length - 1
            ? <span aria-current="page">{crumb.name}</span>
            : <a href={crumb.url}>{crumb.name}</a>}
          </li>
        ))}</ol>
      </nav>
    )}
    <slot />
  </main>
  <footer class="hints">
    <div class="wrap">
      <span><kbd>j</kbd> <kbd>k</kbd> navigate</span>
      <span><kbd>o</kbd> open</span>
      <span><kbd>s</kbd> favorite</span>
      <span><kbd>/</kbd> search</span>
      <span><a href={`${root}support/`} style="text-decoration: underline;">support</a></span>
      <span><a href={`${root}privacy/`} style="text-decoration: underline;">privacy</a></span>
      <span><a href="#" class="ch2-open-settings-btn" style="text-decoration: underline;">cookie settings</a></span>
      <span class="right">
        <slot name="footer-right" />
        <span class="visit-count" title="Cumulative page views, including imported Cloudflare history and reloads.">page views: <span data-visit-counter>—</span></span>
      </span>
    </div>
  </footer>
  <div id="search-overlay" hidden>
    <div class="search-panel" role="dialog" aria-label="Search">
      <div class="search-head">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="search-input" placeholder={`grep ${postCount} posts by title, summary or tag…`} autocomplete="off" />
        <kbd>esc</kbd>
      </div>
      <div class="search-filters">
        <select id="f-source" aria-label="Filter by source"><option value="">All sources</option></select>
        <select id="f-tag" aria-label="Filter by tag"><option value="">All tags</option></select>
      </div>
      <div id="search-results" class="search-results"><p class="search-empty">// type to search</p></div>
    </div>
  </div>
  <div id="article-share-menu" class="share-menu" role="menu" aria-label="Share article" hidden>
    <button type="button" role="menuitem" tabindex="-1" data-share-copy>Copy link</button>
    <a role="menuitem" tabindex="-1" data-share-platform="linkedin" target="_blank" rel="noopener noreferrer">Share on LinkedIn</a>
    <a role="menuitem" tabindex="-1" data-share-platform="x" target="_blank" rel="noopener noreferrer">Share on X</a>
    <a role="menuitem" tabindex="-1" data-share-platform="bluesky" target="_blank" rel="noopener noreferrer">Share on Bluesky</a>
    <p data-share-status role="status" aria-live="polite"></p>
    <input data-share-url aria-label="Article URL to copy" readonly hidden />
  </div>
  <script src={`${root}app.js`} defer></script>
  <script is:inline type="module" src={`${root}account.js`}></script>
  <script is:inline src={`${root}share.js`} defer></script>
  <script is:inline src={`${root}visit-counter.js`} defer></script>
</body>
</html>
