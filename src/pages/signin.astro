---
import Base from '../layouts/Base.astro';
---
<Base title="Sign in - devreads.fyi">
  <section class="account-panel">
    <div class="page-head">
      <h1 style="font-family: var(--mono);">$ keep --favorites</h1>
      <p>Your favorite reads, wherever you read next.</p>
    </div>
    <p>Sign in to sync your favorites across devices. Favorites saved in this browser will automatically merge into your account.</p>
    <div class="provider-buttons" data-guest-only>
      <button class="account-button provider-button" type="button" data-auth-provider="google" hidden><svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285f4" d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.4 9.4 0 0 1-4.1 6.2v5.2h6.6c3.9-3.6 6.1-8.9 6.1-15.1Z"/><path fill="#34a853" d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.6-5.2c-1.8 1.2-4.1 2-6.9 2-5.3 0-9.8-3.6-11.4-8.3H5.8v5.3A20.4 20.4 0 0 0 24 44Z"/><path fill="#fbbc05" d="M12.6 27.6a12.2 12.2 0 0 1 0-7.2v-5.3H5.8a20.4 20.4 0 0 0 0 17.8Z"/><path fill="#ea4335" d="M24 12.1c3 0 5.6 1 7.7 3l5.8-5.8A19.6 19.6 0 0 0 24 4 20.4 20.4 0 0 0 5.8 15.1l6.8 5.3C14.2 15.7 18.7 12.1 24 12.1Z"/></svg>Continue with Google</button>
    </div>
    <p class="account-callout" data-auth-setup>Account sync is being set up. You can keep favoriting articles on this device in the meantime.</p>
    <p data-signed-in-only hidden>You're signed in. <a href={`${import.meta.env.BASE_URL}favorites/`}>Open your favorites</a> or <a href={`${import.meta.env.BASE_URL}account/`}>manage your account</a>.</p>
    <p class="account-fine">Browsing and favoriting on this device are always available without an account. <a href={`${import.meta.env.BASE_URL}privacy/`}>Privacy details</a></p>
  </section>
</Base>
